# ========================================================
# CryptoVote Application Environment Configuration Template
# DO NOT put real passwords here! Copy this file to .env and fill in values.
# ========================================================

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change_this_to_a_random_secret_in_production

# Database Connection (Default is local SQLite; Person A provides MySQL RDS for production)
# Local SQLite format: sqlite:///cryptovote.db
# AWS RDS MySQL format: mysql+pymysql://<user>:<password>@<rds-endpoint>:3306/cryptovote_db
DATABASE_URL=sqlite:///cryptovote.db

# Admin Secret Key (used to authorize election closure and chain verification)
ADMIN_SECRET_KEY=super_secure_admin_key_for_demo

# AWS Cloud Settings (Person A will provide these)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=cryptovote-results-demo
USE_PARAMETER_STORE=False
PARAMETER_STORE_PREFIX=/cryptovote/
